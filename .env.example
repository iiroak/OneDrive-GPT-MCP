# Local development environment. The deployed service uses
# deploy/env/outlook.env.example and is configured through MCP Admin.

# Microsoft Entra application credentials. Use the secret VALUE, not its ID.
MS_CLIENT_ID=your-client-id-here
MS_CLIENT_SECRET=your-client-secret-value-here
MS_TENANT_ID=consumers
MS_SCOPES=offline_access openid profile User.Read Mail.ReadWrite Mail.Send MailboxSettings.ReadWrite Calendars.ReadWrite Files.ReadWrite

# Optional local token location.
MS_TOKEN_STORE_PATH=~/.local/share/outlook-mcp/microsoft-tokens.json

# Server-side OneDrive capability and import limits.
OUTLOOK_ONEDRIVE_DOWNLOAD_CAPABILITY_TTL=1800
OUTLOOK_ONEDRIVE_IMPORT_ALLOWED_HOSTS=localhost
OUTLOOK_ONEDRIVE_IMPORT_MAX_BYTES=209715200
OUTLOOK_CHATGPT_FILE_ALLOWED_HOSTS=files.oaiusercontent.com,files.openaiusercontent.com,oaisdmnt*.blob.core.windows.net,mcp.iroak.dev,sdmntpr*.oaiusercontent.com
