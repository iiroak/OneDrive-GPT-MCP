OUTLOOK_HTTP_HOST=127.0.0.1
OUTLOOK_HTTP_PORT=8767
OUTLOOK_PUBLIC_BASE_URL=https://mcp.iroak.dev/outlook
OUTLOOK_DATA_DIR=/var/lib/mcp/outlook
MS_TOKEN_STORE_PATH=/var/lib/mcp/outlook/microsoft-tokens.json
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=consumers
MS_REDIRECT_URI=https://mcp.iroak.dev/outlook/microsoft/callback
MS_SCOPES=offline_access openid profile User.Read Mail.ReadWrite Mail.Send MailboxSettings.ReadWrite Calendars.ReadWrite Files.ReadWrite
OUTLOOK_MCP_TOKEN=
OUTLOOK_OAUTH_SECRET=
MCP_ADMIN_OUTLOOK_TOKEN=
