OUTLOOK_HTTP_HOST=127.0.0.1
OUTLOOK_HTTP_PORT=8767
OUTLOOK_PUBLIC_BASE_URL=https://mcp.example.com/outlook
OUTLOOK_DATA_DIR=~/.local/share/outlook-mcp
MS_TOKEN_STORE_PATH=~/.local/share/outlook-mcp/microsoft-tokens.json
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=consumers
MS_REDIRECT_URI=https://mcp.example.com/outlook/microsoft/callback
MS_SCOPES=offline_access openid profile User.Read Mail.ReadWrite Mail.Send MailboxSettings.ReadWrite Calendars.ReadWrite Files.ReadWrite
OUTLOOK_MCP_TOKEN=
OUTLOOK_OAUTH_SECRET=
MCP_ADMIN_OUTLOOK_TOKEN=
# Optional override for ChatGPT file parameter download hosts.
OUTLOOK_CHATGPT_FILE_ALLOWED_HOSTS=files.oaiusercontent.com,files.openaiusercontent.com,oaisdmnt*.blob.core.windows.net
