[Unit]
Description=Outlook and OneDrive MCP
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=onedrive-gpt-mcp
Group=onedrive-gpt-mcp
EnvironmentFile=%h/.config/onedrive-gpt-mcp.env
WorkingDirectory=%h/onedrive-gpt-mcp
StateDirectory=onedrive-gpt-mcp
StateDirectoryMode=0700
Environment=OUTLOOK_DATA_DIR=%S/onedrive-gpt-mcp
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
